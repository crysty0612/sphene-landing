/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://sphene.app; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self';
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: document-domain=()
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  X-Robots-Tag: all, max-image-preview:large, max-snippet:-1, max-video-preview:-1

/.git/*
  X-Robots-Tag: noindex, nofollow, noarchive
  Content-Security-Policy: default-src 'none'

/llms.txt
  Content-Type: text/markdown; charset=utf-8
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=3600

/llms-full.txt
  Content-Type: text/markdown; charset=utf-8
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=3600

/sphene-image*.tar.gz
  Content-Type: application/gzip
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=3600

/sphene-image.tar.gz
  Content-Type: application/gzip
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=3600

/hermes-skill.tar.gz
  Content-Type: application/gzip
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=3600

/.well-known/llms.txt
  Content-Type: text/markdown; charset=utf-8
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=3600

/robots.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=86400

/sitemap.xml
  Content-Type: application/xml; charset=utf-8
  Cache-Control: public, max-age=86400

/*.sh
  Content-Type: text/plain; charset=utf-8
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=3600

/SHA256SUMS
  Content-Type: text/plain; charset=utf-8
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=3600

/assets/fonts/*
  Content-Type: font/woff2
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=31536000, immutable

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/bin/*
  Content-Type: application/octet-stream
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=3600

/css/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/js/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
